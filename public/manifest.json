{
  "name": "Budget Bro",
  "short_name": "Budget Bro",
  "description": "Your bro for budgeting — track income, expenses and savings with zero complexity.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f7f5f2",
  "theme_color": "#0d7a52",
  "orientation": "portrait-primary",
  "categories": ["finance", "productivity"],
  "share_target": {
    "action": "/share-target-v2",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "receipt",
          "accept": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "application/pdf",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".pdf"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
